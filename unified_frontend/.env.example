# 前端开发服务固定对外监听地址与端口
VITE_DEV_PORT=3000

# 公网访问域名。默认留空，前端会使用当前访问地址的同源 /api。
# 只有当前端静态文件和 API 不在同一个域名下时，才设置为 https://aicv.fudar.com。
VITE_PUBLIC_ORIGIN=

# Vite 代理到后端服务的目标地址
# 仅开发服务代理使用，浏览器端生产构建不会直接请求这些内网地址。
VITE_BACKEND_TARGET=http://127.0.0.1:5000

# 下面三个地址由 unified_backend 使用，不再由前端直接代理。
# UNIFIED_GUARD_ROOM_URL=http://127.0.0.1:5001
# UNIFIED_AIVISION_URL=http://127.0.0.1:7862
# UNIFIED_SECURITY_VLM_URL=http://127.0.0.1:8000

# 可选：覆盖浏览器端请求地址。不填时默认使用 VITE_PUBLIC_ORIGIN。
# VITE_API_BASE=https://aicv.fudar.com
# VITE_WS_BASE=wss://aicv.fudar.com
# VITE_AIVISION_URL=https://aicv.fudar.com/aivision/

# 是否启用动态导航（从后端 API 加载）
# true = 启用动态导航  false = 使用硬编码 fallback
VITE_ENABLE_DYNAMIC_NAV=true
AUTH_TOKEN_EXPIRE_HOURS= 8640