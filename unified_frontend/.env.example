# 前端开发服务固定对外监听地址与端口
VITE_DEV_PORT=13000

# 公网访问域名。生产构建推荐设置为 https://aicv.fudar.com
# 设置后，未单独指定的 API / WebSocket / AiVision 嵌入页都会使用该域名。
VITE_PUBLIC_ORIGIN=https://aicv.fudar.com

# Vite 代理到后端服务的目标地址
# 仅开发服务代理使用，浏览器端生产构建不会直接请求这些内网地址。
VITE_BACKEND_TARGET=http://127.0.0.1:15000
VITE_AIVISION_BACKEND_TARGET=http://127.0.0.1:17862
VITE_SECURITY_VLM_BACKEND_TARGET=http://127.0.0.1:18000

# 可选：覆盖浏览器端请求地址。不填时默认使用 VITE_PUBLIC_ORIGIN。
# VITE_API_BASE=https://aicv.fudar.com
# VITE_WS_BASE=wss://aicv.fudar.com
# VITE_AIVISION_URL=https://aicv.fudar.com/aivision/
