# AiVision backend environment template
# 复制为 .env 后按现场环境修改。

# ---------------- Database ----------------
SQL_ENABLE=true
MYSQL_DB_URL=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=your_password
MYSQL_DB_NAME=aivision
MYSQL_DB_CHARSET=utf8mb4
AUTO_CREATE_DB=false

# ---------------- Hikvision personnel sync ----------------
# 手动同步：在项目根目录执行 python -m AiVision.platform.face_library.sync
# 真实凭据只放环境变量或本地 .env，禁止提交到 Git。
HIKVISION_ONE_BASE_URL=https://hikvision-one.example
HIKVISION_ONE_APP_KEY=replace-with-app-key
HIKVISION_ONE_APP_SECRET=replace-with-app-secret
HIKVISION_ONE_ARTEMIS_PATH=/artemis
HIKVISION_ONE_VERIFY_TLS=true
HIKVISION_ONE_PAGE_SIZE=100
HIKVISION_ONE_CONNECT_TIMEOUT=8
HIKVISION_ONE_READ_TIMEOUT=25

HIKVISION_TWO_BASE_URL=https://hikvision-two.example
HIKVISION_TWO_APP_KEY=replace-with-app-key
HIKVISION_TWO_APP_SECRET=replace-with-app-secret
HIKVISION_TWO_ARTEMIS_PATH=/artemis
HIKVISION_TWO_VERIFY_TLS=true
HIKVISION_TWO_PAGE_SIZE=100
HIKVISION_TWO_CONNECT_TIMEOUT=8
HIKVISION_TWO_READ_TIMEOUT=25

# ---------------- Face recognition runtime ----------------
# NVIDIA GPU 环境就绪后改为 CUDAExecutionProvider；不设置独立模型目录环境变量。
# GPU 可见范围由 AiVision 运行环境统一设置（如 CUDA_VISIBLE_DEVICES）。
# InsightFace 使用当前进程可见的逻辑设备 0，不单独指定服务器物理 GPU。
INSIGHTFACE_EXECUTION_PROVIDER=CPUExecutionProvider
INSIGHTFACE_DETECTION_SIZE=640
INSIGHTFACE_DETECTION_THRESHOLD=0.5
FACE_INDEX_REFRESH_SECONDS=60
FACE_INFERENCE_TIMEOUT=5

# ---------------- Storage ----------------
# 违规图片保存目录
DATA_PATH=/usr/zyy/Fuda_CVPreject/AiVision/data
# AsyncViolationWriter 每批最大入库数量
MAX_EVENT_COUNT=30
# AsyncViolationWriter 最长 flush 间隔，单位秒
INTERVAL=5
# 报警图片保留天数；同时受目录容量上限约束
ALARM_MEDIA_RETENTION_DAYS=7
# 报警图片目录容量上限（GB），超过后从最旧记录开始清理
ALARM_MEDIA_MAX_GB=10
# 启动时立即清理一次，之后按该间隔重复执行（分钟）
ALARM_MEDIA_CLEANUP_INTERVAL_MINUTES=60
# 公共报警证据视频：报警前后各保留多少秒，以及视频采样帧率。
ALARM_CLIP_ENABLED=true
ALARM_CLIP_PRE_SECONDS=10
ALARM_CLIP_POST_SECONDS=10
ALARM_CLIP_FPS=5
ALARM_CLIP_MAX_WIDTH=960

# ---------------- API ----------------
API_HOST=0.0.0.0
API_PORT=17862
# Pydantic 复杂类型建议使用 JSON 字符串
CORS_ORIGINS=["*"]

# ---------------- Managed visual services ----------------
# Guard Room 与 Security VLM 的 API 由 AiVision 进程内承载，不再配置独立端口。
# 默认值会从 AiVision/integrations 自动定位；只有目录布局不同时才需要覆盖。
# GUARD_ROOM_CONFIG_PATH=/usr/zyy/Fuda_CVPreject_V3/AiVision/integrations/guard_room/config/config.yaml
# SECURITY_VLM_CONFIG_PATH=/usr/zyy/Fuda_CVPreject_V3/AiVision/integrations/security_vlm/configs/config.yaml

# ---------------- Runtime ----------------
# AiVision API/Consumer 主进程中的 OpenCV 内部线程数。
# 多摄像头场景不应直接使用宿主机全部 CPU 核心。
OPENCV_NUM_THREADS=4
# 单次画面读取与 JPEG 编码超过该秒数时输出分阶段慢日志。
FRAME_SLOW_LOG_SECONDS=1.0
# 连续多少次推理未完整成功后触发系统异常告警，以及 Consumer 本地告警冷却时间。
INFERENCE_ALERT_CONSECUTIVE_FAILURES=3
INFERENCE_ALERT_COOLDOWN_SECONDS=300
# 模型 Worker 就绪等待、看门狗轮询和自动重启退避参数。
MODEL_WORKER_READY_TIMEOUT=60
MODEL_WORKER_WATCHDOG_INTERVAL_SECONDS=5
MODEL_WORKER_RESTART_MAX_ATTEMPTS=3
MODEL_WORKER_RESTART_BACKOFF_SECONDS=5
MODEL_WORKER_RESTART_MAX_BACKOFF_SECONDS=60
# Worker 连续稳定运行该秒数后，清零本轮重启次数。
MODEL_WORKER_RESTART_RESET_SECONDS=300

# ---------------- Model paths ----------------
# 本机模型路径覆盖文件。相对路径以 AiVision 目录为基准。
MODEL_PATHS_CONFIG=config/model_paths.yaml

# ---------------- Alarm ----------------
HORN_ENABLE=false
HORN_URL=http://localhost:7862/      #喇叭地址

WECHAT_ENABLE=true
WECHAT_CORP_ID=replace-with-wechat-corp-id
WECHAT_CORP_SECRET=replace-with-wechat-corp-secret
WECHAT_AGENT_ID=1000050
# 企业微信图文卡片里的缩略图和详情页公网根地址
WECHAT_CARD_BASE_URL=https://aicv.fudar.com

# ---------------- Debug ----------------
# 留空: 不输出 feature debug；all: 全部；或 blocks,detect_phone
DEBUG_FEATURES=all
