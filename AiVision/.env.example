# AiVision backend environment template
# 复制为 .env 后按现场环境修改。

# ---------------- Database ----------------
SQL_ENABLE=true
MYSQL_DB_URL=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=your_password
MYSQL_DB_NAME=aivision
MYSQL_DB_CHARSET=utf8mb4
AUTO_CREATE_DB=false

# ---------------- Hikvision personnel sync ----------------
# 手动同步：在项目根目录执行 python -m AiVision.features.face_recognition.library.sync
# 真实凭据只放环境变量或本地 .env，禁止提交到 Git。
HIKVISION_ONE_BASE_URL=https://hikvision-one.example
HIKVISION_ONE_APP_KEY=replace-with-app-key
HIKVISION_ONE_APP_SECRET=replace-with-app-secret
HIKVISION_ONE_ARTEMIS_PATH=/artemis
HIKVISION_ONE_VERIFY_TLS=true
HIKVISION_ONE_PAGE_SIZE=100
HIKVISION_ONE_CONNECT_TIMEOUT=8
HIKVISION_ONE_READ_TIMEOUT=25

HIKVISION_TWO_BASE_URL=https://hikvision-two.example
HIKVISION_TWO_APP_KEY=replace-with-app-key
HIKVISION_TWO_APP_SECRET=replace-with-app-secret
HIKVISION_TWO_ARTEMIS_PATH=/artemis
HIKVISION_TWO_VERIFY_TLS=true
HIKVISION_TWO_PAGE_SIZE=100
HIKVISION_TWO_CONNECT_TIMEOUT=8
HIKVISION_TWO_READ_TIMEOUT=25

# ---------------- Storage ----------------
# 违规图片保存目录
DATA_PATH=/usr/zyy/Fuda_CVPreject/AiVision/data
# AsyncViolationWriter 每批最大入库数量
MAX_EVENT_COUNT=30
# AsyncViolationWriter 最长 flush 间隔，单位秒
INTERVAL=5
# 报警媒体、识别截图、安检会话及数据库图片保留天数，至少 31 天
ALARM_MEDIA_RETENTION_DAYS=31
# 磁盘媒体容量告警阈值（GB）；超限只告警，不提前删除保留期内证据，0 表示关闭容量告警
ALARM_MEDIA_MAX_GB=10
# 启动时立即清理一次，之后按该间隔重复执行（分钟）
ALARM_MEDIA_CLEANUP_INTERVAL_MINUTES=60
# 公共报警证据视频：报警前后各保留多少秒，以及视频采样帧率。
ALARM_CLIP_ENABLED=true
ALARM_CLIP_PRE_SECONDS=10
ALARM_CLIP_POST_SECONDS=10
ALARM_CLIP_FPS=5
ALARM_CLIP_MAX_WIDTH=960

# ---------------- API ----------------
API_HOST=0.0.0.0
API_PORT=7862
# 正常停止时等待已接收的 HTTP 请求和 AGV 回调完成的上限（秒）。
SHUTDOWN_GRACE_SECONDS=75
# Pydantic 复杂类型建议使用 JSON 字符串
CORS_ORIGINS=["*"]

# ---------------- 持续视频预览 ----------------
# go2rtc 由 scripts/go2rtc_preview.sh 独立管理，API 仅监听本机。
GO2RTC_BASE_URL=http://127.0.0.1:1984
# 留空使用 JPEG；填写逗号分隔的规范标识，仅名单中的摄像头与功能使用原始视频。
# 例如 camera_113,camera_63,camera_64,camera_65；单个标识也有效。
GO2RTC_PREVIEW_CAMERA_KEY=
# 支持逗号分隔多个功能，例如 security_fence,guard_behavior。
GO2RTC_PREVIEW_FEATURE=security_fence
# 已建立的视频连接按此间隔复查账号、归属和功能权限，范围 1～5 秒。
GO2RTC_AUTH_CHECK_SECONDS=5

# ---------------- 摄像头镜头变焦 ----------------
# 管理协议和端口独立于 RTSP；HTTPS 按设备实际端口设置，并保留证书校验。
CAMERA_ZOOM_SCHEME=http
CAMERA_ZOOM_PORT=80
CAMERA_ZOOM_REQUEST_TIMEOUT_SECONDS=2
# 每次短步在启动回执后等待的秒数，以及设备方向控制范围的比例（非光学倍率）。
CAMERA_ZOOM_STEP_SECONDS=0.25
CAMERA_ZOOM_SPEED_FRACTION=0.2
# 连续短步复用已确认能力，重新检测仍实时查询设备；0 禁用缓存。
CAMERA_ZOOM_CAPABILITY_CACHE_SECONDS=30

# ---------------- Internal inspection model ----------------
# 内部福达AI如启用鉴权，在本地环境填写；接口地址与模型名由数据库维护。
SECURITY_VLM_API_KEY=
# 安检与平台助手共享的福达AI请求并发上限，避免聊天绕过视觉任务的资源预算。
QWEN_MAX_CONCURRENT_REQUESTS=3
# 平台助手的后台工作线程、排队容量及单次任务边界。
ASSISTANT_WORKERS=1
ASSISTANT_QUEUE_CAPACITY=16
ASSISTANT_MAX_ROUNDS=24
ASSISTANT_MAX_CHANGES=100
ASSISTANT_HISTORY_TURNS=6

# ---------------- Runtime ----------------
# AiVision API/Consumer 主进程中的 OpenCV 内部线程数。
# 多摄像头场景不应直接使用宿主机全部 CPU 核心。
OPENCV_NUM_THREADS=4
# 摄像头启动时同时探测、等待首帧的最大路数，范围 1～16。
CAMERA_START_WORKERS=4
# 摄像头关停时同时回收的最大路数，范围 1～16。
CAMERA_STOP_WORKERS=8
# 安检同时在途的人体检测请求数量，范围 1～4，避免逐路累计排队等待。
SECURITY_INSPECTION_INFLIGHT=4
# 共享模型输入队列短暂满载时的最大提交等待时间，避免瞬时拥塞直接丢弃当前帧。
INFERENCE_QUEUE_SUBMIT_WAIT_SECONDS=0.1
# 非闯闸人体检测的普通队列容量。非法闯闸另保留 4 个独立任务位置。
HUMAN_ORDINARY_QUEUE_CAPACITY=16
# 单次画面读取与 JPEG 编码超过该秒数时输出分阶段慢日志。
FRAME_SLOW_LOG_SECONDS=1.0
# 连续多少次推理未完整成功后触发系统异常告警，以及 Consumer 本地告警冷却时间。
INFERENCE_ALERT_CONSECUTIVE_FAILURES=3
INFERENCE_ALERT_COOLDOWN_SECONDS=300
# 模型 Worker 就绪等待、看门狗轮询和自动重启退避参数。
MODEL_WORKER_READY_TIMEOUT=60
MODEL_WORKER_WATCHDOG_INTERVAL_SECONDS=5
MODEL_WORKER_RESTART_MAX_ATTEMPTS=3
MODEL_WORKER_RESTART_BACKOFF_SECONDS=5
MODEL_WORKER_RESTART_MAX_BACKOFF_SECONDS=60
# Worker 连续稳定运行该秒数后，清零本轮重启次数。
MODEL_WORKER_RESTART_RESET_SECONDS=300

# ---------------- Model paths ----------------
# 本机模型路径覆盖文件。相对路径以 AiVision 目录为基准。
MODEL_PATHS_CONFIG=config/model_paths.yaml

# ---------------- Alarm ----------------
HORN_ENABLE=false
HORN_URL=http://localhost:7862/      #喇叭地址

WECHAT_ENABLE=true
WECHAT_CORP_ID=replace-with-wechat-corp-id
WECHAT_CORP_SECRET=replace-with-wechat-corp-secret
WECHAT_AGENT_ID=1000050
# 企业微信图文卡片里的缩略图和详情页公网根地址
WECHAT_CARD_BASE_URL=https://aicv.fudar.com
# 人员报警签名缩略图有效期（秒，60–604800）；签名复用启动脚本注入的 AUTH_SECRET。
WECHAT_THUMBNAIL_TTL_SECONDS=86400

# ---------------- Debug ----------------
# 留空: 不输出 feature debug；all: 全部；或 blocks,detect_phone
DEBUG_FEATURES=all

# auth 与统一后端共用的认证配置；账号和访问审计存入上述 MySQL。
# scripts/start.sh 会统一注入 AUTH_SECRET；单独启动服务时必须配置同一密钥。
# AUTH_SECRET=replace-with-a-unique-32-plus-character-secret
AUTH_TOKEN_EXPIRE_HOURS=never
PLATFORM_OWNER_EMPLOYEE_ID=260210063
ACCESS_AUDIT_RETENTION_DAYS=90

# 指令驱动智慧安防：业务只调用 Adapter，上游主模型由 Adapter 管理
JOYAI_ADAPTER_URL=http://172.16.0.32:8070
JOYAI_REQUEST_TIMEOUT_SECONDS=45
JOYAI_MAX_WORKERS=4
JOYAI_QUESTION_TIMEOUT_SECONDS=90
