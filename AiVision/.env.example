# AiVision backend environment template
# 复制为 .env 后按现场环境修改。

# ---------------- Database ----------------
SQL_ENABLE=true
MYSQL_DB_URL=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=your_password
MYSQL_DB_NAME=aivision
MYSQL_DB_CHARSET=utf8mb4
AUTO_CREATE_DB=false

# ---------------- Storage ----------------
# 违规图片保存目录
DATA_PATH=/usr/zyy/Fuda_CVPreject/AiVision/data
# AsyncViolationWriter 每批最大入库数量
MAX_EVENT_COUNT=30
# AsyncViolationWriter 最长 flush 间隔，单位秒
INTERVAL=5
# 报警图片保留天数；同时受目录容量上限约束
ALARM_MEDIA_RETENTION_DAYS=7
# 报警图片目录容量上限（GB），超过后从最旧记录开始清理
ALARM_MEDIA_MAX_GB=10
# 启动时立即清理一次，之后按该间隔重复执行（分钟）
ALARM_MEDIA_CLEANUP_INTERVAL_MINUTES=60

# ---------------- API ----------------
API_HOST=0.0.0.0
API_PORT=17862
# Pydantic 复杂类型建议使用 JSON 字符串
CORS_ORIGINS=["*"]

# ---------------- Managed visual services ----------------
# Guard Room 与 Security VLM 的 API 由 AiVision 进程内承载，不再配置独立端口。
# 默认值会从 AiVision/integrations 自动定位；只有目录布局不同时才需要覆盖。
# GUARD_ROOM_CONFIG_PATH=/usr/zyy/Fuda_CVPreject_V3/AiVision/integrations/guard_room/config/config.yaml
# SECURITY_VLM_CONFIG_PATH=/usr/zyy/Fuda_CVPreject_V3/AiVision/integrations/security_vlm/configs/config.yaml

# ---------------- Runtime ----------------
# AiVision API/Consumer 主进程中的 OpenCV 内部线程数。
# 多摄像头场景不应直接使用宿主机全部 CPU 核心。
OPENCV_NUM_THREADS=4
# 单次画面读取与 JPEG 编码超过该秒数时输出分阶段慢日志。
FRAME_SLOW_LOG_SECONDS=1.0

# ---------------- Model paths ----------------
# 本机模型路径覆盖文件。相对路径以 AiVision 目录为基准。
MODEL_PATHS_CONFIG=config/model_paths.yaml

# ---------------- Alarm ----------------
HORN_ENABLE=false
HORN_URL=http://localhost:7862/      #喇叭地址

WECHAT_ENABLE=true
WECHAT_CORP_ID=ww1d48c67a70416f56
WECHAT_CORP_SECRET=O_PYfVZrjA20xTp9vSPDTUg1Yk9Tcabb9O2ot5rdRqg
WECHAT_AGENT_ID=1000050
# 企业微信图文卡片里的缩略图和详情页公网根地址
WECHAT_CARD_BASE_URL=https://aicv.fudar.com

# ---------------- Debug ----------------
# 留空: 不输出 feature debug；all: 全部；或 blocks,detect_phone
DEBUG_FEATURES=all
