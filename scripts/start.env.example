# =============================================================================
# 福达视觉平台冷启动脚本 - 本地覆盖配置示例
# -----------------------------------------------------------------------------
# 复制本文件为 scripts/cold_start.env 后按需修改。
# 脚本会先自动探测；本文件里设置的值会覆盖探测结果。
# 所有项都可选，未设置则用脚本默认值或自动探测。
# =============================================================================

# 项目根目录（不设置则用脚本所在目录的上一级）
# FUDA_CVP_ROOT=/path/to/Fuda_CVPreject

# ---- 运行时路径覆盖 --------------------------------------------------------

# nvm 初始化脚本（运行 unified_frontend Vite 服务用）。若用系统 node 不需要设
# 常见路径：~/.nvm/nvm.sh、/usr/local/nvm/nvm.sh、/opt/nvm/nvm.sh
# NVM_SH=/root/.nvm/nvm.sh

# conda 初始化脚本（AiVision、统一后端 用）
# 常见路径：~/miniconda3/etc/profile.d/conda.sh、/opt/conda/etc/profile.d/conda.sh
# CONDA_SH=/root/miniconda3/etc/profile.d/conda.sh

# AiVision Conda 环境（默认 aivision）
# AIVISION_ENV=aivision

# 统一后端 Conda 环境（默认 unified_backend；存在时自动激活）
# UNIFIED_BACKEND_ENV=unified_backend

# 统一后端 Python（可选；设置后优先于 Conda 环境和系统 Python）
# UNIFIED_BACKEND_PYTHON=/usr/bin/python3

# ---- 版本/环境名 -----------------------------------------------------------

# Node 版本（探测系统 node 时也用此版本做主版本号匹配）
# NODE_VERSION=20

# ---- 健康检查上限（秒）------------------------------------------------------
# 轮询模式下，成功立即返回；调大上限只影响"真的启动很慢"的场景。
# AiVision 包括数据库结构校验和原生 API 初始化；启动命令退出会提前报告失败。
# WAIT_AIVISION=90
# WAIT_UNIFIED_BACKEND=15
