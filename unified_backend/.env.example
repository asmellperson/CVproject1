# Unified backend must use the same AUTH_SECRET as Guard Room and AiVision.
AUTH_SECRET=replace-with-the-same-32-plus-char-secret-used-by-subservices
AUTH_TOKEN_EXPIRE_HOURS=never

# User database. The default below is automatic and normally needs no override:
# <project-root>/runtime/auth/auth_users.db
# AUTH_USERS_DB=/srv/Fuda_CVPreject/runtime/auth/auth_users.db

# AiVision is the single visual control-plane URL. Guard Room and Security VLM
# worker addresses are configured in AiVision, not in the unified backend.
UNIFIED_AIVISION_URL=http://127.0.0.1:7862

# Shared asynchronous proxy pool. Defaults target 50 viewers at 5 fps.
UNIFIED_PROXY_MAX_CONNECTIONS=512
UNIFIED_PROXY_MAX_KEEPALIVE_CONNECTIONS=128
UNIFIED_PROXY_CONNECT_TIMEOUT_SECONDS=3
UNIFIED_PROXY_POOL_TIMEOUT_SECONDS=2
UNIFIED_PROXY_WRITE_TIMEOUT_SECONDS=10
UNIFIED_PROXY_READ_TIMEOUT_SECONDS=10
